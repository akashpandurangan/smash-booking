# Copy to .env.local and fill in. Leave blank to run in DEMO MODE (no backend, demo payments).
# These are PUBLIC values (safe in the browser). NEVER put a service_role key or Razorpay SECRET here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Razorpay public Key ID only (rzp_test_... or rzp_live_...). Leave blank for the demo payment flow.
VITE_RAZORPAY_KEY_ID=
