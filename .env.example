# Copy to .env.local and fill in. Leave Supabase blank to run in DEMO MODE (local sample data, demo payments).
# Everything here is PUBLIC (it ships to the browser). NEVER put a service_role key or a Razorpay SECRET here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Primary domain that hosts the platform and, as subdomains, every facility (<slug>.<this domain>).
VITE_ROOT_DOMAIN=smashbooking.com

# Set to "true" ONLY after *.smashbooking.com is added in Vercel and DNS has propagated.
# While it is not "true", owners are shown the working link  <your-site>/f/<slug>  instead of the subdomain.
VITE_WILDCARD_DOMAIN_READY=false

# NOTE: there is no Razorpay setting here. Each facility connects ITS OWN Razorpay account in
# Owner dashboard → Payments; the secret is stored server-side by an Edge Function.
